{
  "name": "community-frontend",
  "version": "1.0.0",
  "description": "Community frontend for the sungjin board project",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:3001": "PORT=3001 node server.js",
    "start:backend": "./start_backend.sh",
    "clean-install": "rm -rf node_modules package-lock.json && npm install",
    "test": "node --test tests/*.test.js",
    "test:integration": "node verify_api.js",
    "test:upload": "node verify_upload_gateway.js"
  },
  "keywords": [
    "express",
    "frontend",
    "community",
    "vanilla-js"
  ],
  "author": "sungjin",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
