#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y git nodejs npm amazon-efs-utils

mkdir -p /mnt/efs
mount -t efs -o tls ${efs_id}:/ /mnt/efs || true

git clone --branch ${frontend_repo_branch} ${frontend_repo_url} /opt/community-fe
cd /opt/community-fe
npm ci --omit=dev

cat > /opt/community-fe/.env <<ENV
PORT=3001
API_URL=${backend_api_url}
FILE_UPLOAD_API_URL=${file_upload_api_url}
NODE_ENV=production
ENV

cat > /etc/systemd/system/community-frontend.service <<SERVICE
[Unit]
Description=Community Frontend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/community-fe
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable community-frontend
systemctl restart community-frontend
